<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required on API 33+ to show Athan/reminder notifications; requested at runtime on the onboarding Notifications screen -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed to call the Athan prayer-times API over Ktor -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Coarse is enough for prayer-time calculation accuracy; fine is requested alongside it
         since FusedLocationProviderClient returns a better fix when both are granted. Requested
         at runtime on the onboarding Location screen -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".AthanlyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Athanly">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Athanly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>